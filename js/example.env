# .env file used by load_dotenv to insert environment variables in the jupter environment
# copy example.env to .env

# Chat providers: OPENAI_API_KEY
# Direct provider access (default); only the selected provider needs a key
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Optional: For evaluation and tracing
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRACING=false
LANGSMITH_AGENT_ID=lc-essentials
LANGSMITH_AGENT_ENVIRONMENT=local
# Optional: route supported OpenAI/Anthropic chat models through LangSmith Gateway
LANGSMITH_GATEWAY=false
# LANGSMITH_GATEWAY=true
# Uses LANGSMITH_API_KEY above; optionally override model-call authentication:
# LANGSMITH_GATEWAY_API_KEY=your_langsmith_gateway_api_key_here
# For a regional gateway, use its base URL instead of true:
# LANGSMITH_GATEWAY=https://eu.gateway.smith.langchain.com
